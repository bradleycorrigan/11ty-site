<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/style.css">
    <script type="module">
        import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs";
        mermaid.initialize({ startOnLoad: true });

        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll("pre code.language-mermaid").forEach(block => {
                const parent = block.parentNode;
                const graphDef = block.textContent;
                const div = document.createElement("div");
                div.classList.add("mermaid");
                div.textContent = graphDef;
                parent.replaceWith(div);
            });
            mermaid.init();
        });
    </script>
</head>
<body class="light-theme"> <!-- Default theme class -->
    <!-- Sidebar toggle button -->
    <button class="sidebar-toggle" onclick="toggleSidebar()" title="Menu">☰</button>
    <!-- Dark mode toggle button -->
    <button class="dark-mode-toggle" onclick="toggleDarkMode()" title="Toggle dark/light theme">🌓</button>

    <!-- Sidebar -->
    <div class="sidebar collapsed">
        <div class="sidebar-header">
            📖 Menu
        </div>
        <nav>
            <ul>
                <!-- Hardcoded link for the homepage -->
                <li><a href="/">🏡 Home</a></li>
                <li><a href="https://photos.bradleycorrigan.co.uk">📸 Pictures</a></li>
                {% for post in collections.posts %}
                    <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
                {% endfor %}
            </ul>
        </nav>
    </div>

    <!-- Main content -->
    <div class="content collapsed">
        <header>
            <h1>{{ title }}</h1>
        </header>

        <!-- Tags section (only shows if tags exist) -->
        {% if tags and tags.length > 0 %}
            <div class="post-tags">
                <strong>Tags:</strong>
                {% for tag in tags %}
                    {% if tag != "posts" %}
                        <a href="/tags/{{ tag | slugify }}/" class="tag">#{{ tag }}</a>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}

        <main>
            {{ content | safe }}
        </main>
    </div>

    <script src="/script.js"></script>
</body>
</html>
