<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if page.url == "/" %}Bradley Corrigan{% else %}{{ title }} · Bradley Corrigan{% endif %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="/style.css?v={{ buildTime }}">
    <script type="module">
        import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs";

        // Diagrams take their colours from the site theme and redraw when you switch light/dark
        const blocks = [...document.querySelectorAll("pre code.language-mermaid")].map(code => {
            const mount = document.createElement("div");
            mount.className = "mermaid-diagram";
            const src = code.textContent;
            code.parentNode.replaceWith(mount);
            return { mount, src };
        });
        let n = 0, gen = 0;
        async function draw() {
            if (!blocks.length) return;
            const mine = ++gen;
            const css = getComputedStyle(document.body);
            const v = name => css.getPropertyValue(name).trim();
            const dark = document.body.classList.contains("dark-theme");
            mermaid.initialize({
                startOnLoad: false, securityLevel: "strict", theme: "base",
                fontFamily: 'Inter, system-ui, sans-serif',
                flowchart: { useMaxWidth: true, curve: "basis", padding: 12 },
                themeVariables: {
                    darkMode: dark, fontSize: "15px",
                    background: v("--base-bg"),
                    primaryColor: v("--code-bg"), mainBkg: v("--code-bg"),
                    primaryTextColor: v("--base-fg"), textColor: v("--base-fg"), titleColor: v("--base-accent"),
                    primaryBorderColor: v("--base-accent"), nodeBorder: v("--base-accent"),
                    lineColor: v("--base-muted"),
                    clusterBkg: v("--base-bg"), clusterBorder: v("--border-color"),
                    edgeLabelBackground: v("--code-bg"),
                },
                themeCSS: `
                    .node rect, .node circle, .node polygon { stroke-width: 1.5px; rx: 8px; ry: 8px; }
                    .node .label { font-weight: 500; }
                    .cluster rect { rx: 12px; ry: 12px; stroke-width: 1.5px; stroke-dasharray: 5 4; }
                    .cluster-label .nodeLabel, .cluster-label span { color: ${v("--base-accent")} !important; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; font-size: 12px; }
                    .edgeLabel, .edgeLabel p { font-size: 12px; color: ${v("--base-muted")}; }
                    .flowchart-link { stroke-width: 1.5px; }
                    marker path { fill: ${v("--base-muted")}; stroke: none; }
                `,
            });
            for (const b of blocks) {
                const { svg } = await mermaid.render("mmd-" + n++, b.src);
                if (mine === gen) b.mount.innerHTML = svg;
            }
        }
        draw();
        new MutationObserver(draw).observe(document.body, { attributes: true, attributeFilter: ["class"] });
    </script>
</head>
<body class="light-theme">
    <header class="site-header">
        <div class="wrap{% if wide %} wrap-wide{% endif %}">
            <a class="site-name" href="/">Bradley Corrigan</a>
            <nav class="site-nav" aria-label="Site">
                <a href="/#writing">Writing</a>
                <a href="/#made">Projects</a>
                <a href="https://photos.bradleycorrigan.co.uk">Photos</a>
                <a href="https://github.com/bradleycorrigan">GitHub</a>
                <button type="button" class="theme-toggle" onclick="toggleDarkMode()" aria-label="Switch between light and dark">
                    <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                    <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                </button>
            </nav>
        </div>
    </header>

    <main class="wrap{% if wide %} wrap-wide{% endif %}">
    {% if "/posts/" in page.url %}
        <article>
            <header class="post-header">
                <h1>{{ title }}</h1>
                <p class="post-meta">
                    <time datetime="{{ page.date | date('YYYY-MM-DD') }}">{{ page.date | date }}</time>
                    <span aria-hidden="true">·</span>
                    <span>{{ content | readingTime }}</span>
                    {% for tag in tags %}{% if tag != "posts" %}
                    <a class="topic" href="/tags/{{ tag | slugify }}/">{{ tag | replace("-", " ") }}</a>
                    {% endif %}{% endfor %}
                </p>
            </header>
            <div class="post-body">
                {{ content | safe }}
            </div>
            <footer class="post-footer"><a href="/#writing">← All writing</a></footer>
        </article>
    {% elif hideTitle %}
        {{ content | safe }}
    {% else %}
        <h1 class="page-title">{{ title }}</h1>
        {{ content | safe }}
    {% endif %}
    </main>

    <footer class="site-footer wrap{% if wide %} wrap-wide{% endif %}">Built with Eleventy. Hosted on GitHub Pages.</footer>

    <script src="/script.js?v={{ buildTime }}"></script>
</body>
</html>
