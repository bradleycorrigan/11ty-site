---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag | slugify }}/
layout: base.njk
eleventyComputed:
  title: "{{ tag | replace('-', ' ') | capitalize }}"
---

<div class="section-head">
  <h2 class="section-label">Posts about {{ tag | replace("-", " ") }}</h2>
  <span>{{ collections.postsByTag[tag].length }} post{% if collections.postsByTag[tag].length != 1 %}s{% endif %}</span>
</div>
<ul class="post-list">
{% for post in collections.postsByTag[tag] | reverse %}
  <li>
    <a href="{{ post.url }}">
      <time datetime="{{ post.date | date('YYYY-MM-DD') }}">{{ post.date | date('short') }}</time>
      <span class="post-title">{{ post.data.title }}</span>
    </a>
  </li>
{% endfor %}
</ul>

<p class="post-footer"><a href="/tags/">← All topics</a></p>
